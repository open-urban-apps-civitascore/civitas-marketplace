AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=dev-only-marketplace-nextauth-secret
KEYCLOAK_CLIENT_ID=marketplace
KEYCLOAK_CLIENT_SECRET=dev-only-marketplace-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/civitas-core
# id_token signature algorithm; local realm uses Keycloak's RS256 default,
# the cluster realm signs with ES256 (then set ES256 here).
#KEYCLOAK_ID_TOKEN_ALG=RS256
API_BASE_URL=http://localhost
API_PORT=9080
# Portal frontend, for "view in portal" links (defaults to http://localhost:3000).
PORTAL_URL=http://localhost:3000

# --- Add-on installs: the instance's deployment repository ---
# Add-ons are components of the instance itself, so installing one is a change
# to its deployment configuration. The marketplace proposes that change as a
# pull request; an operator reviews, merges and applies it.
#
# The token belongs to the SERVICE (a machine account), never to the person
# clicking install — no user needs a forge account. It only needs permission to
# write branches and open pull requests on this one repository; there is no code
# path that merges.
#
# Without DEPLOYMENT_REPO_TOKEN the feature stays usable: the change is composed
# and shown in full so an operator can apply it by hand.
DEPLOYMENT_REPO=<owner>/<repository>
# The branch that describes the live instance — pull requests target it, and its
# component list is the one that gains the entry.
DEPLOYMENT_REPO_BRANCH=main
# Folder under deployment/environments/ belonging to this instance.
DEPLOYMENT_ENVIRONMENT=<environment>
#DEPLOYMENT_REPO_TOKEN=