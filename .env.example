AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=dev-only-marketplace-nextauth-secret
KEYCLOAK_CLIENT_ID=marketplace
KEYCLOAK_CLIENT_SECRET=dev-only-marketplace-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/civitas-core
# id_token signature algorithm; local realm uses Keycloak's RS256 default,
# the cluster realm signs with ES256 (then set ES256 here).
#KEYCLOAK_ID_TOKEN_ALG=RS256
API_BASE_URL=http://localhost
API_PORT=9080
# Portal frontend, for "view in portal" links (defaults to http://localhost:3000).
PORTAL_URL=http://localhost:3000

# --- Add-on installs: the instance's deployment repository ---
# Installing an add-on changes the instance's deployment configuration, so the
# marketplace proposes it as a pull request. The token belongs to a machine
# account, never to the person clicking install. Without it the change is still
# composed and shown, just not opened as a pull request.
DEPLOYMENT_REPO=<owner>/<repository>
DEPLOYMENT_REPO_BRANCH=main
DEPLOYMENT_ENVIRONMENT=<environment>
#DEPLOYMENT_REPO_TOKEN=


# --- Use-case catalogue ---
# Catalogue source: the git-hosted repo-list (raw URL of index.json).
# Unset = the app serves the bundled demo fixtures (offline mode, no network).
# MOCK_CATALOG=1 forces the fixtures even when a URL is configured.
REPO_LIST_URL=https://gitlab.com/civitascore-openurbanapps/civitas-marketplace-catalog/-/raw/main/index.json
# How long a fetched index is served before re-fetching (default 900).
#REPO_LIST_TTL_SECONDS=900
# Demo-data simulator (in-cluster service). Unset = every simulator-backed UI
# element (sample preview, later the demo install) is hidden.
#SIMULATOR_API_URL=http://demo-data-generator.demo.svc.cluster.local:4300
