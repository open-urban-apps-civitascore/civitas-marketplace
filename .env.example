AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=dev-only-marketplace-nextauth-secret
KEYCLOAK_CLIENT_ID=marketplace
KEYCLOAK_CLIENT_SECRET=dev-only-marketplace-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/civitas-core
# id_token signature algorithm; local realm uses Keycloak's RS256 default,
# the cluster realm signs with ES256 (then set ES256 here).
#KEYCLOAK_ID_TOKEN_ALG=RS256
API_BASE_URL=http://localhost
API_PORT=9080
# Portal frontend, for "view in portal" links (defaults to http://localhost:3000).
PORTAL_URL=http://localhost:3000

# --- Add-on installs: the instance's deployment repository ---
# Installing an add-on changes the instance's deployment configuration, so the
# marketplace proposes it as a pull request. The token belongs to a machine
# account, never to the person clicking install. Without it the change is still
# composed and shown, just not opened as a pull request.
DEPLOYMENT_REPO=<owner>/<repository>
DEPLOYMENT_REPO_BRANCH=main
DEPLOYMENT_ENVIRONMENT=<environment>
#DEPLOYMENT_REPO_TOKEN=


# --- Use-case catalogue ---
# Catalogue source: the git-hosted repo-list (raw URL of index.json).
# Unset = the app serves the bundled demo fixtures (offline mode, no network).
# MOCK_CATALOG=1 forces the fixtures even when a URL is configured.
REPO_LIST_URL=https://gitlab.com/civitascore-openurbanapps/civitas-marketplace-catalog/-/raw/main/index.json
# How long a fetched index is served before re-fetching (default 900).
#REPO_LIST_TTL_SECONDS=900
# Demo-data simulator (in-cluster service). Unset = every simulator-backed UI
# element (sample preview, later the demo install) is hidden.
#SIMULATOR_API_URL=http://demo-data-generator.demo.svc.cluster.local:4300
# The simulator's own web interface as a BROWSER reaches it, for the links from
# an installed use case to its demo streams. Not SIMULATOR_API_URL: that is the
# generator's control API, an address inside the cluster. Unset = no links.
#SIMULATOR_UI_URL=http://localhost:3003
# Broker the SIMULATOR publishes to, overriding the package's datasource URL.
# Needed when the simulator runs outside the docker network (e.g. `pnpm dev` on
# the host): the package says tcp://civitas-mosquitto:1883, the host needs
# tcp://localhost:1883. Unset = the package value is used as-is.
# 1884, not 1883: the dev stack's civitas-frost already publishes 1883, so the
# demo broker is published on 1884. Only needed when the simulator runs outside
# the docker network, where the package's container-name URL does not resolve.
#SIMULATOR_BROKER_URL=tcp://localhost:1884

# --- Dashboards (Superset) ---
# A use case may bring a Superset dashboard; the install imports it, bound to
# the new dataset. While a setting is missing, the install summary names it and
# the dashboard is skipped. API address as the marketplace reaches it.
#SUPERSET_API_URL=http://localhost:8098
# Browser address for the link in the install result (defaults to the API address).
#SUPERSET_PUBLIC_URL=http://localhost:8098
# Name of the Superset database connection that reads the platform's PostGIS
# data storage. Instance knowledge, so it never travels in a package.
#SUPERSET_DATABASE_NAME=PostgreSQL geoserver
# An account with a local Superset password (API login with provider "db"),
# or a token instead. Accounts that only sign in through Keycloak have no
# local password.
#SUPERSET_USERNAME=
#SUPERSET_PASSWORD=
#SUPERSET_TOKEN=

# --- Use-case export ("Teilen"): where a package may be proposed ---
# JSON array of target repositories (GitLab). `pathPrefix` is the folder the
# package directory <slug>/ is created under ('.' = repository root); the
# catalogue repository itself works as a target with a prefix, because
# catalogue rows carry a `path`. One token serves every target and the
# catalogue: a bot account's GitLab token with scope `api`. Targets the token
# cannot push to are handled through the bot's fork (the normal way to
# contribute to a repository you have no rights on). Without the token the
# preview still works, only the merge requests do not.
#EXPORT_TARGET_REPOS=[{"label":"Katalog-Repo (packages/)","url":"https://gitlab.com/civitascore-openurbanapps/civitas-marketplace-catalog","baseBranch":"main","pathPrefix":"packages"}]
#EXPORT_REPO_TOKEN=
# Catalogue repository the entry merge request targets; derived from
# REPO_LIST_URL when unset (…/-/raw/<branch>/index.json names both).
#CATALOG_REPO_URL=https://gitlab.com/civitascore-openurbanapps/civitas-marketplace-catalog
#CATALOG_REPO_BRANCH=main

DEPLOYMENT_REPO=